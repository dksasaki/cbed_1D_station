diag_table
# ... but the simple template ships its diag_table link (-> diag_table_no_daily)
!station_1d_simple/model/diag_table

# Tools, installed by "pixi install" and "pixi run install-fre-nctools"
/.pixi/
/opt/

# Simple template: everything its steps and the model write. The GofME run
# inside station_1d_simple/ is kept on disk but never committed.
station_1d_simple/experiment.txt
station_1d_simple/run_*.out
station_1d_simple/model/mom6
station_1d_simple/model/INPUT/
station_1d_simple/model/history/
station_1d_simple/model/RESTART_*/
station_1d_simple/model/*_parameter_doc.*
station_1d_simple/model/*.out
station_1d_simple/model/input.nml

# Station grids are generated by ./setup_station.sh, not version controlled.
INPUT/grids/
# ... and the INPUT symlinks that point into them.
INPUT/ocean_hgrid.nc
INPUT/ocean_topog.nc
INPUT/topog.nc
INPUT/ocean_mosaic.nc
INPUT/ocean_mask.nc
INPUT/atmos_mosaic.nc
INPUT/land_mosaic.nc
INPUT/land_mask.nc
INPUT/grid_spec.nc
INPUT/atmos_mosaic_tile1Xocean_mosaic_tile1.nc
INPUT/land_mosaic_tile1Xocean_mosaic_tile1.nc
INPUT/sponge_damping.nc
INPUT/sponge_state_woa13.nc
INPUT/sponge_bgc.nc

# Restart files linked into INPUT/ by run_multiyear.sh between segments
INPUT/*.res.nc
INPUT/coupler.res

# Per-segment archives from run_multiyear.sh
history/

