#
# Atmospheric deposition -- global 12-month climatologies.
# NOTE: these are PRE-INDUSTRIAL fields (PI / mean.1860). Upstream CEFI has
# moved to ESM4 1993-2014 present-day climatologies (see NWA12.COBALT), which
# also carry WET Fe and dust deposition that these files lack. Swap if you
# need present-day forcing.
 "OCN", "dry_dep_fed_flux_ice_ocn",  "FLUX",         "./INPUT/Soluble_Fe_Flux_PI.nc",       "bilinear", -1.0
 "OCN", "dry_dep_lith_flux_ice_ocn", "FLUX_MINERAL", "./INPUT/Mineral_Fe_Flux_PI.nc",       "bilinear", -1.0
